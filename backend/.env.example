# Runtime
NODE_ENV=development
PORT=3000

# Database (do not commit real credentials)
DATABASE_URL=

# Auth / session
SESSION_SECRET=
ADMIN_SETUP_TOKEN=
APP_BASE_URL=

# SMTP email delivery (required when seller email verification is enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Protected media storage
# local is for development only; production must use s3.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./media-data
MEDIA_URL_SECRET=
# Optional upload limit; defaults to 5 GiB when omitted.
MEDIA_MAX_UPLOAD_BYTES=

# S3-compatible protected media storage (required when MEDIA_STORAGE_PROVIDER=s3)
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional custom S3-compatible endpoint (Cloudflare R2, MinIO, etc.)
MEDIA_S3_ENDPOINT=

# Payment (Stripe is the implemented live checkout adapter)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-domain.example/pages/purchase-complete.html
STRIPE_CANCEL_URL=https://your-domain.example/pages/video-list.html
