# Runtime
NODE_ENV=development
PORT=3000

# Database (do not commit real credentials)
DATABASE_URL=

# Auth / session
SESSION_SECRET=

# Protected media storage
# local is for development only; production must use s3.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./media-data
MEDIA_URL_SECRET=
# Optional upload limit; defaults to 5 GiB when omitted.
MEDIA_MAX_UPLOAD_BYTES=

# S3-compatible protected media storage (required when MEDIA_STORAGE_PROVIDER=s3)
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional custom S3-compatible endpoint (Cloudflare R2, MinIO, etc.)
MEDIA_S3_ENDPOINT=

# Payment
# Supported provider selection is currently runtime-configured.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Stripe checkout configuration (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Provider credentials recognized by the provider configuration layer.
# Only populate the provider you actually configure.
PAYPAL_CLIENT_SECRET=
ADYEN_API_KEY=
PADDLE_API_KEY=
PAYPAY_API_KEY=
